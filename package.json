{
  "name": "obsidian-sealbox",
  "version": "0.1.0",
  "description": "Encrypted notes, attachments and secrets for Obsidian.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "verify": "node tools/check-bundle.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run verify"
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.28.2",
    "obsidian": "latest",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@lezer/markdown": "^1.7.2",
    "@noble/ciphers": "^1.2.0",
    "hash-wasm": "^4.12.0",
    "pdfjs-dist": "^4.10.38"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Scar333/obsidian-sealbox"
  }
}
